{
  "name": "calendardate",
  "version": "3.0.1",
  "description": "Gregorian calendar widget - A framework-agnostic vanilla TypeScript library for displaying holidays and events.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/**/*.ts && tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:isarjanfaza/CalendarDate.git"
  },
  "bugs": {
    "url": "https://github.com/isarjanfaza/CalendarDate/issues"
  },
  "homepage": "https://github.com/isarjanfaza/CalendarDate#readme",
  "keywords": [
    "gregorian",
    "calendar",
    "date",
    "time",
    "holidays",
    "events",
    "widget"
  ],
  "author": "Isar Janfaza",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "eslint": "^8.57.0",
    "rollup": "^4.13.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.3",
    "vitest": "^1.4.0"
  }
}
